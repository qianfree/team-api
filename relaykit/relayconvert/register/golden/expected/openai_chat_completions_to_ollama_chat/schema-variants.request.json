{
  "messages": [
    {
      "content": "Search the repo with the where filter.",
      "role": "user"
    }
  ],
  "model": "upstream-model",
  "options": {
    "num_predict": 512
  },
  "stream": false,
  "tools": [
    {
      "function": {
        "description": "search repo",
        "name": "grep",
        "parameters": {
          "properties": {
            "query": {
              "properties": {
                "paths": {
                  "type": "array"
                },
                "pattern": {
                  "type": "string"
                },
                "tag": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                "where": {
                  "items": {
                    "prefixItems": [
                      {
                        "type": "string"
                      },
                      {
                        "enum": [
                          "AND",
                          "OR"
                        ],
                        "type": "string"
                      },
                      {}
                    ],
                    "type": "array"
                  },
                  "maxItems": 10,
                  "type": "array"
                }
              },
              "required": [
                "pattern"
              ],
              "type": "object"
            }
          },
          "required": [
            "query"
          ],
          "type": "object"
        }
      },
      "type": "function"
    }
  ]
}
