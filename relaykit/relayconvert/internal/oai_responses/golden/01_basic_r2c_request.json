{
  "name": "basic_responses_to_oai_chat_request",
  "from": "responses",
  "to": "openai",
  "request": {
    "input": "Hello world",
    "instructions": "你是一个翻译助手",
    "max_output_tokens": 1024,
    "model": "gpt-4o",
    "stream": false,
    "temperature": 0.7,
    "top_p": 0.9
  },
  "expected_request": {
    "model": "gpt-4o-2024-11-20",
    "messages": [
      {
        "role": "system",
        "content": "你是一个翻译助手"
      },
      {
        "role": "user",
        "content": "Hello world"
      }
    ],
    "max_tokens": 1024,
    "temperature": 0.7,
    "top_p": 0.9,
    "stream": false
  }
}